#!/usr/bin/env bash
# Screenshot helper: full screen, selected region, or active window.
set -euo pipefail

MODE="${1:-full}"
DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/kraken-$(date +%Y%m%d-%H%M%S).png"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a KRAKEN "$@" || true; }

if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v grim >/dev/null 2>&1; then
    case "$MODE" in
        full)
            grim "$FILE"
            ;;
        region)
            if command -v slurp >/dev/null 2>&1; then
                geom="$(slurp 2>/dev/null)" || exit 0
                [[ -n "$geom" ]] || exit 0
                grim -g "$geom" "$FILE"
            else
                grim "$FILE"
            fi
            ;;
        window)
            geom=""
            if [[ -n "${SWAYSOCK:-}" ]] && command -v swaymsg >/dev/null 2>&1; then
                geom="$(swaymsg -t get_tree 2>/dev/null | python3 -c '
import json, sys
def find_focused(node):
    if node.get("focused") and node.get("rect"):
        r = node["rect"]
        if r.get("width", 0) > 0 and r.get("height", 0) > 0:
            return f"{r[\"x\"]},{r[\"y\"]} {r[\"width\"]}x{r[\"height\"]}"
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        res = find_focused(child)
        if res:
            return res
    return ""
try:
    print(find_focused(json.load(sys.stdin)))
except Exception:
    pass
' || true)"
            fi
            if [[ -n "$geom" ]]; then
                grim -g "$geom" "$FILE"
            elif command -v slurp >/dev/null 2>&1; then
                geom="$(slurp 2>/dev/null)" || exit 0
                [[ -n "$geom" ]] || exit 0
                grim -g "$geom" "$FILE"
            else
                grim "$FILE"
            fi
            ;;
        *)
            echo "usage: kraken-screenshot [full|region|window]" >&2
            exit 2
            ;;
    esac
else
    if ! command -v maim >/dev/null 2>&1; then
        notify "screenshot failed" "grim / maim is not installed"
        exit 1
    fi

    case "$MODE" in
        full)
            maim "$FILE"
            ;;
        region)
            maim -s "$FILE" || exit 0
            ;;
        window)
            if command -v xdotool >/dev/null 2>&1; then
                window="$(xdotool getactivewindow 2>/dev/null || true)"
                if [[ -n "$window" ]]; then
                    maim -i "$window" "$FILE"
                else
                    maim -s "$FILE" || exit 0
                fi
            else
                maim -s "$FILE" || exit 0
            fi
            ;;
        *)
            echo "usage: kraken-screenshot [full|region|window]" >&2
            exit 2
            ;;
    esac
fi

[[ -s "$FILE" ]] || exit 0

if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png < "$FILE" 2>/dev/null || true
elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -t image/png -i "$FILE" || true
fi

notify -i "$FILE" "screenshot saved" "$(basename "$FILE")"

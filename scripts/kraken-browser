#!/usr/bin/env bash
# Launch Chromium with KRAKEN's flags, or the dashboard when no URL is given.
#
# The Pi 4 v3d driver exposes GLES 3.1 through EGL, which is why Debian's
# chromium wrapper adds --use-angle=gles. Extra flags can be appended with
# KRAKEN_BROWSER_FLAGS, e.g. KRAKEN_BROWSER_FLAGS=--disable-gpu kraken-browser
set -euo pipefail

URL="${1:-${KRAKEN_URL:-http://127.0.0.1:8080/}}"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a KRAKEN "$@" || true; }

clean_stale_singleton() {
    local profile_dir="${HOME}/.config/chromium"
    local lock="${profile_dir}/SingletonLock"
    [[ -L "$lock" ]] || return 0
    if pgrep -u "$(id -u)" -x chromium >/dev/null 2>&1 || pgrep -u "$(id -u)" -f '/usr/lib/chromium/chromium' >/dev/null 2>&1; then
        return 0
    fi
    rm -f "${profile_dir}/SingletonLock" "${profile_dir}/SingletonCookie" "${profile_dir}/SingletonSocket" 2>/dev/null || true
}

browser=""
for candidate in chromium chromium-browser google-chrome-stable; do
    if command -v "$candidate" >/dev/null 2>&1; then
        browser="$candidate"
        break
    fi
done

if [[ -z "$browser" ]]; then
    notify "no browser installed" "install chromium or run: kraken web"
    printf '%s\n' "$URL"
    exit 1
fi

flags=(
    --no-first-run
    --no-default-browser-check
    --password-store=basic
    --disable-features=Translate,MediaRouter
    --class=Chromium
)
# shellcheck disable=SC2206
[[ -n "${KRAKEN_BROWSER_FLAGS:-}" ]] && flags+=(${KRAKEN_BROWSER_FLAGS})

clean_stale_singleton
exec "$browser" "${flags[@]}" "$URL"

#!/usr/bin/env bash
# i3 autostart: wait for the daemon, then open the dashboard on workspace 2.
set -euo pipefail

URL="${KRAKEN_URL:-http://127.0.0.1:8080/}"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/kraken-autostart.lock"

exec 9>"$LOCK"
if ! flock -n 9; then
    exit 0
fi

healthy() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time 1 "${URL%/}/healthz" >/dev/null 2>&1
    else
        python3 - "$URL" <<'PY'
import sys, urllib.request
url = sys.argv[1].rstrip("/") + "/healthz"
try:
    with urllib.request.urlopen(url, timeout=1) as response:
        sys.exit(0 if response.status == 200 else 1)
except Exception:
    sys.exit(1)
PY
    fi
}

for _ in $(seq 1 40); do
    if healthy; then
        kraken-dashboard
        exit 0
    fi
    sleep 1
done

if command -v notify-send >/dev/null 2>&1; then
    notify-send -a KRAKEN -u normal "dashboard not ready" "the daemon is not answering on ${URL}"
fi
exit 0

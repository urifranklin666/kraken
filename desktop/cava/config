[general]
framerate = 60
bars = 56
bar_width = 3
bar_spacing = 1
sensitivity = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

[input]
method = pulse
source = auto
autoconnect = 2

[output]
method = ncurses
channels = mono
mono_option = average

[color]
gradient = 1
gradient_color_1 = '#7dcfff'
gradient_color_2 = '#7aa2f7'
gradient_color_3 = '#bb9af7'
gradient_color_4 = '#f7768e'

[smoothing]
noise_reduction = 0.74

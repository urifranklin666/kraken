[global]
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    sticky_history = yes
    history_length = 40
    dmenu = rofi -dmenu -p dunst -theme ~/.config/rofi/kraken.rasi
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    gap_size = 10
    corner_radius = 10

    background = "#16161e"
    foreground = "#c0caf5"
    highlight = "#7dcfff"

    width = 380
    height = (120, 120)
    origin = top-right
    offset = (18, 44)
    scale = 0
    notification_limit = 6

    timeout = 6
    idle_threshold = 0

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 360

[urgency_low]
    background = "#16161e"
    foreground = "#a9b1d6"
    frame_color = "#565f89"
    timeout = 4

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 6

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0

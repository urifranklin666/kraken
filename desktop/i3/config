# KRAKEN i3 session — Tokyo Night neon
# i3 4.24 (gaps are built in; the old i3-gaps fork is obsolete)

set $mod Mod4

set $bg        #16161e
set $bg-alt    #1a1b26
set $bg-soft   #1f2335
set $fg        #c0caf5
set $muted     #565f89
set $blue      #7aa2f7
set $cyan      #7dcfff
set $magenta   #bb9af7
set $green     #9ece6a
set $yellow    #e0af68
set $red       #f7768e
set $wallpaper /usr/share/kraken/wallpaper.png

# fonts ---------------------------------------------------------------------
font pango:JetBrainsMono Nerd Font 10

# look ----------------------------------------------------------------------
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 10
gaps outer 14
smart_gaps on
title_align left
focus_follows_mouse no
mouse_warping output
popup_during_fullscreen smart
workspace_auto_back_and_forth yes

client.focused          $blue    $blue    $bg     $cyan    $blue
client.focused_inactive $bg-soft $bg-soft $fg     $muted   $bg-soft
client.unfocused        $bg-alt  $bg-alt  $muted  $bg-alt  $bg-alt
client.urgent           $red     $red     $bg     $yellow  $red
client.placeholder      $bg-alt  $bg-alt  $fg     $bg-alt  $bg-alt
client.background       $bg

# workspace names -----------------------------------------------------------
set $ws1  "1:term"
set $ws2  "2:web"
set $ws3  "3:wifi"
set $ws4  "4:cap"
set $ws5  "5:stats"
set $ws6  "6:lab"
set $ws7  "7:notes"
set $ws8  "8:media"
set $ws9  "9:sys"
set $ws10 "10:scratch"

# launchers -----------------------------------------------------------------
bindsym $mod+Return          exec --no-startup-id alacritty
bindsym $mod+Shift+Return    exec --no-startup-id alacritty --class kraken-term
bindsym $mod+d               exec --no-startup-id rofi -show drun -theme ~/.config/rofi/kraken.rasi
bindsym $mod+Shift+b         exec --no-startup-id kraken-browser
bindsym $mod+Shift+d         exec --no-startup-id kraken-dashboard
bindsym $mod+F1              exec --no-startup-id kraken-help
bindsym $mod+Shift+space     exec --no-startup-id kraken-menu
bindsym $mod+Shift+e         exec --no-startup-id kraken-power
# not $mod+Shift+l: that is "move right" (h/j/k/l move bindings)
bindsym $mod+Control+l       exec --no-startup-id kraken-lock
bindsym $mod+Shift+x         exec --no-startup-id kraken-panic
bindsym $mod+Shift+w         exec --no-startup-id kraken-web
bindsym XF86AudioRaiseVolume exec --no-startup-id kraken-volume up
bindsym XF86AudioLowerVolume exec --no-startup-id kraken-volume down
bindsym XF86AudioMute        exec --no-startup-id kraken-volume mute
bindsym XF86MonBrightnessUp   exec --no-startup-id kraken-brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id kraken-brightness down
bindsym Print                exec --no-startup-id kraken-screenshot full
bindsym $mod+Print           exec --no-startup-id kraken-screenshot region
bindsym $mod+Shift+Print     exec --no-startup-id kraken-screenshot window

# window management ---------------------------------------------------------
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle
bindsym $mod+space floating toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

# focus ---------------------------------------------------------------------
set $left  h
set $down  j
set $up    k
set $right l

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# move ----------------------------------------------------------------------
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# layout --------------------------------------------------------------------
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+z layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+z layout toggle split

# workspaces ----------------------------------------------------------------
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

bindsym $mod+Tab workspace back_and_forth
bindsym $mod+ctrl+Right workspace next_on_output
bindsym $mod+ctrl+Left  workspace prev_on_output

# session -------------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+Escape exec --no-startup-id i3-msg exit
bindsym $mod+Shift+p exec --no-startup-id kraken-power

# resize mode ---------------------------------------------------------------
mode "resize" {
    bindsym $left  resize shrink width 5 px or 5 ppt
    bindsym $down  resize grow height 5 px or 5 ppt
    bindsym $up    resize shrink height 5 px or 5 ppt
    bindsym $right resize grow width 5 px or 5 ppt
    bindsym Left  resize shrink width 5 px or 5 ppt
    bindsym Down  resize grow height 5 px or 5 ppt
    bindsym Up    resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# window rules --------------------------------------------------------------
# kraken-dashboard launches Chromium with --class=Kraken
for_window [class="Kraken"] move to workspace $ws2, workspace $ws2
for_window [class="Chromium" title="KRAKEN.*"] move to workspace $ws2, workspace $ws2
for_window [class="kraken-term"] floating enable, resize set 1100 640, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="Pavucontrol"] floating enable, resize set 720 520, move position center
for_window [class="Nm-connection-editor"] floating enable, resize set 900 620, move position center
for_window [class="Lxappearance"] floating enable
for_window [class="Gcolor3"] floating enable
for_window [class="Yad"] floating enable, border normal
for_window [title="^(Open|Save)"] floating enable
for_window [class="feh"] floating enable, fullscreen enable

# autostart -----------------------------------------------------------------
exec --no-startup-id xsetroot -cursor_name left_ptr
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id feh --no-fehbg --bg-fill $wallpaper
exec --no-startup-id dunst
exec --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id kraken-autostart

# keep the pointer sane
exec --no-startup-id xset r rate 250 35
